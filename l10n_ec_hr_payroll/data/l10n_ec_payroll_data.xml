<?xml version="1.0" encoding="utf-8"?>
<!--
    Ecuador Payroll Data 2026
    =========================

    Official Sources:
    - SBU 2026: Ministerio de Trabajo, Acuerdo MDT-2025-195 ($482),
      Registro Oficial Suplemento 187 (2025)
    - IESS: tasas de aportación oficiales publicadas en iess.gob.ec
      (sector privado: personal 9.45% / patronal 11.15%)
    - Código del Trabajo (RO Suplemento 906, 20-dic-2016):
      décimo tercero art. 111, décimo cuarto art. 113,
      utilidades art. 97 y 105, vacaciones art. 69, horas art. 55,
      fondo de reserva art. 196, desahucio art. 186,
      indemnización art. 188, maternidad/paternidad art. 152-153

    All values configurable via ir.config_parameter
-->
<odoo>
    <data noupdate="0">

        <!-- ================================================================
             SALARIO BÁSICO UNIFICADO (SBU) y aportes IESS base
             ================================================================
             `l10n_ec.sbu`, `l10n_ec.iess_aporte_personal` y
             `l10n_ec.iess_aporte_patronal` son parámetros COMPARTIDOS
             (también los lee l10n_ec_reports, que solo depende de
             l10n_ec_base). Se definen UNA sola vez, en
             l10n_ec_base/data/l10n_ec_sri_config.xml — fuente canónica.
             Este módulo depende de l10n_ec_base, por lo que garantiza su
             existencia sin duplicar la clave (ir.config_parameter.key es
             única). Valores idénticos: SBU $482 (MDT-2025-195),
             personal 9.45% / patronal 11.15%.
        ================================================================= -->

        <!-- ================================================================
             IESS CONTRIBUTION RATES 2026 (complementarias)
             Fuente: tasas de aportación oficiales, iess.gob.ec
             (sector privado: total personal 9.45% / patronal 11.15%)
        ================================================================= -->

        <!-- SECAP (Capacitación) - Empleador: 0.50%
             (aporte patronal adicional recaudado vía IESS; proyectos de ley
             de 2026 en trámite proponen redirigirlo — sigue vigente) -->
        <record id="l10n_ec_iess_secap" model="ir.config_parameter">
            <field name="key">l10n_ec.iess_secap</field>
            <field name="value">0.5</field>
        </record>

        <!-- IECE (Crédito Educativo) - Empleador: 0.50% -->
        <record id="l10n_ec_iess_iece" model="ir.config_parameter">
            <field name="key">l10n_ec.iess_iece</field>
            <field name="value">0.5</field>
        </record>

        <!-- Techo de aportación: 25 × SBU = $12,050 (SBU $482).
             Aplica a la BASE de cálculo, nunca al salario.
             NO_VERIFICADO: no se localizó la norma que fije el múltiplo
             25×SBU en las fuentes oficiales consultadas; verificar. -->
        <record id="l10n_ec_iess_techo_sbu" model="ir.config_parameter">
            <field name="key">l10n_ec.iess_ceiling_sbu_multiplicador</field>
            <field name="value">25</field>
        </record>

        <!-- Sector Público - Personal: 11.45% -->
        <record id="l10n_ec_iess_personal_publico" model="ir.config_parameter">
            <field name="key">l10n_ec.iess_aporte_personal_publico</field>
            <field name="value">11.45</field>
        </record>

        <!-- Sector Público - Patronal (Estado): 9.15% -->
        <record id="l10n_ec_iess_patronal_publico" model="ir.config_parameter">
            <field name="key">l10n_ec.iess_aporte_patronal_publico</field>
            <field name="value">9.15</field>
        </record>

        <!-- Afiliación Voluntaria: 17.60% -->
        <record id="l10n_ec_iess_voluntario" model="ir.config_parameter">
            <field name="key">l10n_ec.iess_aporte_voluntario</field>
            <field name="value">17.60</field>
        </record>

        <!-- ================================================================
             FONDOS DE RESERVA
             8.33% del salario (equivalente a 1 mes por año de servicio
             posterior al primero)
             Art. 196 Código del Trabajo (RO Supl. 906, 20-dic-2016)
        ================================================================= -->

        <record id="l10n_ec_fondos_reserva" model="ir.config_parameter">
            <field name="key">l10n_ec.fondos_reserva</field>
            <field name="value">8.33</field>
        </record>

        <!-- Elegibilidad: después de 13 meses de servicio continuo.
             El art. 196 otorga el derecho "por más de un año" y por cada
             año completo posterior al primero; el cómputo mensual 8.33%
             desde el mes 13 es práctica habitual. NO_VERIFICADO: no se
             localizó norma expresa que fije "13 meses". -->
        <record id="l10n_ec_fondos_reserva_meses" model="ir.config_parameter">
            <field name="key">l10n_ec.fondos_reserva_meses</field>
            <field name="value">13</field>
        </record>

        <!-- ================================================================
             DÉCIMO TERCER SUELDO
             Equivalente a 1/12 del salario mensual
             Art. 111 Código del Trabajo
        ================================================================= -->

        <record id="l10n_ec_decimo_tercero" model="ir.config_parameter">
            <field name="key">l10n_ec.decimo_tercero_divisor</field>
            <field name="value">12</field>
        </record>

        <!-- Fecha límite pago: 24 de diciembre -->
        <record id="l10n_ec_decimo_tercero_fecha" model="ir.config_parameter">
            <field name="key">l10n_ec.decimo_tercero_deadline</field>
            <field name="value">12-24</field>
        </record>

        <!-- ================================================================
             DÉCIMO CUARTO SUELDO (Bono Escolar)
             = 1 SBU anual ($482 en 2026)
             Art. 113 Código del Trabajo
        ================================================================= -->

        <!-- Fecha límite Sierra/Oriente: 15 agosto -->
        <record id="l10n_ec_decimo_cuarto_sierra" model="ir.config_parameter">
            <field name="key">l10n_ec.decimo_cuarto_deadline_sierra</field>
            <field name="value">08-15</field>
        </record>

        <!-- Fecha límite Costa/Galápagos: 15 marzo -->
        <record id="l10n_ec_decimo_cuarto_costa" model="ir.config_parameter">
            <field name="key">l10n_ec.decimo_cuarto_deadline_costa</field>
            <field name="value">03-15</field>
        </record>

        <!-- Región por defecto cuando el empleado no tiene provincia
             asociada (Costa/Galápagos = 15 marzo, Sierra/Amazonía = 15 agosto) -->
        <record id="l10n_ec_decimo_cuarto_region_default" model="ir.config_parameter">
            <field name="key">l10n_ec.decimo_cuarto_region_default</field>
            <field name="value">sierra</field>
        </record>

        <!-- ================================================================
             UTILIDADES
             15% de utilidades al trabajador
             Art. 97 Código del Trabajo
        ================================================================= -->

        <!-- 10% dividido para todos los trabajadores -->
        <record id="l10n_ec_utilidades_general" model="ir.config_parameter">
            <field name="key">l10n_ec.utilidades_porcentaje_general</field>
            <field name="value">10</field>
        </record>

        <!-- 5% proporcional a cargas familiares -->
        <record id="l10n_ec_utilidades_cargas" model="ir.config_parameter">
            <field name="key">l10n_ec.utilidades_porcentaje_cargas</field>
            <field name="value">5</field>
        </record>

        <!-- Plazo art. 105 Código del Trabajo: liquidación hasta el
             31 de marzo; pago dentro de los 15 días siguientes
             (prácticamente hasta el 15 de abril) -->
        <record id="l10n_ec_utilidades_deadline" model="ir.config_parameter">
            <field name="key">l10n_ec.utilidades_deadline</field>
            <field name="value">04-15</field>
        </record>

        <!-- ================================================================
             VACACIONES
             15 días laborables después de 1 año
             +1 día adicional por cada año después de 5 años (máx 30 días)
             Art. 69 Código del Trabajo
        ================================================================= -->

        <record id="l10n_ec_vacaciones_dias" model="ir.config_parameter">
            <field name="key">l10n_ec.vacaciones_dias_base</field>
            <field name="value">15</field>
        </record>

        <record id="l10n_ec_vacaciones_max" model="ir.config_parameter">
            <field name="key">l10n_ec.vacaciones_dias_max</field>
            <field name="value">30</field>
        </record>

        <!-- ================================================================
             HORAS EXTRAS Y SUPLEMENTARIAS
             Art. 55 Código del Trabajo
        ================================================================= -->

        <!-- Horas suplementarias (hasta 4h/día): 50% recargo -->
        <record id="l10n_ec_horas_suplementarias" model="ir.config_parameter">
            <field name="key">l10n_ec.horas_suplementarias_recargo</field>
            <field name="value">50</field>
        </record>

        <!-- Horas extraordinarias (fines de semana/feriados): 100% recargo -->
        <record id="l10n_ec_horas_extraordinarias" model="ir.config_parameter">
            <field name="key">l10n_ec.horas_extraordinarias_recargo</field>
            <field name="value">100</field>
        </record>

        <!-- Trabajo nocturno: 25% recargo (19h00-06h00) -->
        <record id="l10n_ec_trabajo_nocturno" model="ir.config_parameter">
            <field name="key">l10n_ec.trabajo_nocturno_recargo</field>
            <field name="value">25</field>
        </record>

        <!-- Topes legales art. 55: 4 h suplementarias+extraordinarias
             cada 24 h / 12 h por semana consecutiva -->
        <record id="l10n_ec_horas_max_dia" model="ir.config_parameter">
            <field name="key">l10n_ec.horas_max_dia</field>
            <field name="value">4</field>
        </record>

        <record id="l10n_ec_horas_max_semana" model="ir.config_parameter">
            <field name="key">l10n_ec.horas_max_semana</field>
            <field name="value">12</field>
        </record>

        <!-- ================================================================
             TOPES DE DESCUENTO
             40% del salario líquido para IESS + otras obligaciones;
             33.33% en casos generales de bienes y créditos.
             Las pensiones alimenticias son derecho preferente: se descuentan
             primero y quedan EXENTAS del tope.
             NO_VERIFICADO: no se identificó el decreto/reglamento exacto
             que fija los topes 40% / 33.33% en las fuentes oficiales
             consultadas; verificar antes de producir.
        ================================================================= -->

        <record id="l10n_ec_tope_descuento" model="ir.config_parameter">
            <field name="key">l10n_ec.tope_descuento_porcentaje</field>
            <field name="value">40</field>
        </record>

        <record id="l10n_ec_tope_descuento_decreto" model="ir.config_parameter">
            <field name="key">l10n_ec.tope_descuento_decreto</field>
            <field name="value">33.33</field>
        </record>

        <!-- ================================================================
             AUXILIO DE CESANTÍA — % del décimo tercero total devengado
             por años de servicio cumplidos (>1 año):
               1-5: 25% | 6-10: 50% | 11-15: 75% | 16-20: 100%
               21-24: 110% | 25+: 120%

             ⚠ NO_ES_LEY: esta escala NO existe en el Código del Trabajo
             ecuatoriano (no hay "auxilio de cesantía" en la legislación
             laboral ecuatoriana; el concepto cercano es el desahucio,
             art. 186). Los registros se conservan SOLO por compatibilidad
             con el asistente de liquidaciones (l10n_ec_liquidacion_wizard
             los requiere); se recomienda deprecarlos. Ver
             docs/legal_audit_2026.md.
        ================================================================= -->

        <record id="l10n_ec_cesantia_1_5" model="ir.config_parameter">
            <field name="key">l10n_ec.cesantia_pct_1_5</field>
            <field name="value">25</field>
        </record>
        <record id="l10n_ec_cesantia_6_10" model="ir.config_parameter">
            <field name="key">l10n_ec.cesantia_pct_6_10</field>
            <field name="value">50</field>
        </record>
        <record id="l10n_ec_cesantia_11_15" model="ir.config_parameter">
            <field name="key">l10n_ec.cesantia_pct_11_15</field>
            <field name="value">75</field>
        </record>
        <record id="l10n_ec_cesantia_16_20" model="ir.config_parameter">
            <field name="key">l10n_ec.cesantia_pct_16_20</field>
            <field name="value">100</field>
        </record>
        <record id="l10n_ec_cesantia_21_24" model="ir.config_parameter">
            <field name="key">l10n_ec.cesantia_pct_21_24</field>
            <field name="value">110</field>
        </record>
        <record id="l10n_ec_cesantia_25_mas" model="ir.config_parameter">
            <field name="key">l10n_ec.cesantia_pct_25_mas</field>
            <field name="value">120</field>
        </record>

        <!-- ================================================================
             INDEMNIZACIONES
             Art. 188 Código del Trabajo - Despido Intempestivo
        ================================================================= -->

        <!-- Hasta 3 años: 3 meses -->
        <record id="l10n_ec_despido_hasta_3" model="ir.config_parameter">
            <field name="key">l10n_ec.despido_meses_hasta_3_años</field>
            <field name="value">3</field>
        </record>

        <!-- Más de 3 años: 1 mes por año, máximo 25 meses -->
        <record id="l10n_ec_despido_max" model="ir.config_parameter">
            <field name="key">l10n_ec.despido_meses_max</field>
            <field name="value">25</field>
        </record>

        <!-- Desahucio: 25% de la última remuneración por año -->
        <record id="l10n_ec_desahucio" model="ir.config_parameter">
            <field name="key">l10n_ec.desahucio_porcentaje</field>
            <field name="value">25</field>
        </record>

        <!-- ================================================================
             LICENCIAS DE MATERNIDAD/PATERNIDAD
        ================================================================= -->

        <!-- Maternidad: 12 semanas (84 días) -->
        <record id="l10n_ec_licencia_maternidad" model="ir.config_parameter">
            <field name="key">l10n_ec.licencia_maternidad_dias</field>
            <field name="value">84</field>
        </record>

        <!-- Paternidad: 10 días -->
        <record id="l10n_ec_licencia_paternidad" model="ir.config_parameter">
            <field name="key">l10n_ec.licencia_paternidad_dias</field>
            <field name="value">10</field>
        </record>

    </data>
</odoo>
