# Odoo source ref: 18.0 = stable line matching module versions 18.0.1.0.0
# Switch to Odoo's rolling online branch with: ODOO_REF=saas-18.4
ODOO_REF=18.0

# ---- Database -------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-pg
ODOO_DB=odooec

# ---- Odoo -----------------------------------------------------------
ODOO_ADMIN_PASSWD=change-me-master
ODOO_USER=admin
ODOO_PASSWORD=change-me-admin
ODOO_PROXY_MODE=true
ODOO_WORKERS=4
ODOO_MAX_CRON_THREADS=1
# Multi-tenant (SaaS): one database per tenant, URL ?db=<tenant>
ODOO_LIST_DB=true
ODOO_DBFILTER=odooec.*

# ---- Capacity (millions of transactions) ----------------------------
ODOO_LIMIT_TIME_CPU=1200
ODOO_LIMIT_TIME_REAL=2400
ODOO_LIMIT_MEMORY_HARD=536870912
ODOO_LIMIT_MEMORY_SOFT=402653184
PG_SHARED_BUFFERS=1GB
PG_MAX_CONNECTIONS=60

# ---- Timezone / locale ---------------------------------------------
TZ=America/Guayaquil
