<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================
             codDoc 01 - Factura (SRI schema Factura V2.1.0)
        ============================================================ -->
        <template id="l10n_ec_edi_factura">
            <factura id="comprobante" version="2.1.0">
                <infoTributaria>
                    <ambiente t-out="environment"/>
                    <tipoEmision>1</tipoEmision>
                    <razonSocial t-out="company.name[:300]"/>
                    <nombreComercial t-if="company.l10n_ec_commercial_name" t-out="company.l10n_ec_commercial_name[:300]"/>
                    <ruc t-out="company.vat"/>
                    <claveAcceso t-out="access_key"/>
                    <codDoc>01</codDoc>
                    <estab t-out="access_key[24:27]"/>
                    <ptoEmi t-out="access_key[27:30]"/>
                    <secuencial t-out="access_key[30:39]"/>
                    <dirMatriz t-out="company.street[:300]"/>
                    <agenteRetencion t-if="company.l10n_ec_withhold_agent" t-out="company.l10n_ec_withhold_resolution[:8]"/>
                </infoTributaria>
                <infoFactura>
                    <fechaEmision t-out="move.invoice_date.strftime('%d/%m/%Y')"/>
                    <dirEstablecimiento t-out="company.street[:300]"/>
                    <contribuyenteEspecial t-if="company.l10n_ec_taxpayer_type == 'special'" t-out="company.l10n_ec_special_resolution"/>
                    <obligadoContabilidad t-out="'SI' if company.l10n_ec_forced_accounting else 'NO'"/>

                    <tipoIdentificacionComprador t-out="l10n_ec_identifier_code"/>
                    <razonSocialComprador t-out="partner.name[:300]"/>
                    <identificacionComprador t-out="partner.vat"/>
                    <direccionComprador t-if="partner.street" t-out="partner.street[:300]"/>
                    <totalSinImpuestos t-out="format_monetary(vals['total_sin_impuestos'])"/>
                    <totalDescuento t-out="format_monetary(vals['total_descuento'])"/>
                    <totalConImpuestos>
                        <t t-foreach="vals['taxes']" t-as="tax">
                            <totalImpuesto>
                                <codigo t-out="tax['codigo']"/>
                                <codigoPorcentaje t-out="tax['codigo_porcentaje']"/>
                                <baseImponible t-out="format_monetary(tax['base'])"/>
                                <valor t-out="format_monetary(tax['amount'])"/>
                            </totalImpuesto>
                        </t>
                    </totalConImpuestos>
                    <propina t-out="format_monetary(0.0)"/>
                    <importeTotal t-out="format_monetary(move.amount_total)"/>
                    <moneda>DOLAR</moneda>
                    <pagos>
                         <t t-foreach="vals['pagos']" t-as="pago">
                            <pago>
                                <formaPago t-out="pago['code']"/>
                                <total t-out="format_monetary(pago['amount'])"/>
                            </pago>
                        </t>
                    </pagos>
                </infoFactura>
                <detalles>
                    <t t-foreach="move.invoice_line_ids.filtered(lambda l: not l.display_type)" t-as="line">
                        <detalle>
                            <codigoPrincipal t-out="line.product_id.default_code[:25] if line.product_id.default_code else 'GEN'"/>
                            <descripcion t-out="line.name[:300].replace('\n', ' ')"/>
                            <cantidad t-out="format_float(line.quantity, 6)"/>
                            <precioUnitario t-out="format_float(line.price_unit, 6)"/>
                            <descuento t-out="format_monetary(line.price_unit * line.quantity * (line.discount / 100.0))"/>
                            <precioTotalSinImpuesto t-out="format_monetary(line.price_subtotal)"/>
                            <impuestos>
                                <t t-foreach="line_taxes.get(line.id, [])" t-as="imp">
                                    <impuesto>
                                        <codigo t-out="imp['codigo']"/>
                                        <codigoPorcentaje t-out="imp['codigo_porcentaje']"/>
                                        <tarifa t-out="format_float(imp['tarifa'], 2)"/>
                                        <baseImponible t-out="format_monetary(imp['base'])"/>
                                        <valor t-out="format_monetary(imp['valor'])"/>
                                    </impuesto>
                                </t>
                            </impuestos>
                        </detalle>
                    </t>
                </detalles>
                <infoAdicional t-if="move.narration or partner.email">
                    <campoAdicional nombre="Email" t-if="partner.email" t-out="partner.email"/>
                    <campoAdicional nombre="Notas" t-if="move.narration" t-out="move.narration[:300]"/>
                </infoAdicional>
            </factura>
        </template>

        <!-- ============================================================
             codDoc 03 - Liquidación de Compra (SRI schema
             LiquidacionCompra V1.1.0)

             The emisor is the BUYER (our company) and the "proveedor" is
             the vendor partner. Requires >= 1 <impuesto> per <detalle>.
        ============================================================ -->
        <template id="l10n_ec_edi_liquidacion_compra">
            <liquidacionCompra id="comprobante" version="1.1.0">
                <infoTributaria>
                    <ambiente t-out="environment"/>
                    <tipoEmision>1</tipoEmision>
                    <razonSocial t-out="company.name[:300]"/>
                    <nombreComercial t-if="company.l10n_ec_commercial_name" t-out="company.l10n_ec_commercial_name[:300]"/>
                    <ruc t-out="company.vat"/>
                    <claveAcceso t-out="access_key"/>
                    <codDoc>03</codDoc>
                    <estab t-out="access_key[24:27]"/>
                    <ptoEmi t-out="access_key[27:30]"/>
                    <secuencial t-out="access_key[30:39]"/>
                    <dirMatriz t-out="company.street[:300]"/>
                    <agenteRetencion t-if="company.l10n_ec_withhold_agent" t-out="company.l10n_ec_withhold_resolution[:8]"/>
                </infoTributaria>
                <infoLiquidacionCompra>
                    <fechaEmision t-out="move.invoice_date.strftime('%d/%m/%Y')"/>
                    <dirEstablecimiento t-if="company.street" t-out="company.street[:300]"/>
                    <contribuyenteEspecial t-if="company.l10n_ec_taxpayer_type == 'special'" t-out="company.l10n_ec_special_resolution"/>
                    <obligadoContabilidad t-out="'SI' if company.l10n_ec_forced_accounting else 'NO'"/>
                    <tipoIdentificacionProveedor t-out="l10n_ec_identifier_code"/>
                    <razonSocialProveedor t-out="partner.name[:300]"/>
                    <identificacionProveedor t-out="partner.vat"/>
                    <direccionProveedor t-if="partner.street" t-out="partner.street[:300]"/>
                    <totalSinImpuestos t-out="format_monetary(vals['total_sin_impuestos'])"/>
                    <totalDescuento t-out="format_monetary(vals['total_descuento'])"/>
                    <totalConImpuestos>
                        <t t-foreach="vals['taxes']" t-as="tax">
                            <totalImpuesto>
                                <codigo t-out="tax['codigo']"/>
                                <codigoPorcentaje t-out="tax['codigo_porcentaje']"/>
                                <baseImponible t-out="format_monetary(tax['base'])"/>
                                <valor t-out="format_monetary(tax['amount'])"/>
                            </totalImpuesto>
                        </t>
                    </totalConImpuestos>
                    <importeTotal t-out="format_monetary(move.amount_total)"/>
                    <moneda>DOLAR</moneda>
                    <pagos>
                         <t t-foreach="vals['pagos']" t-as="pago">
                            <pago>
                                <formaPago t-out="pago['code']"/>
                                <total t-out="format_monetary(pago['amount'])"/>
                            </pago>
                        </t>
                    </pagos>
                </infoLiquidacionCompra>
                <detalles>
                    <t t-foreach="move.invoice_line_ids.filtered(lambda l: not l.display_type)" t-as="line">
                        <detalle>
                            <codigoPrincipal t-out="line.product_id.default_code[:25] if line.product_id.default_code else 'GEN'"/>
                            <descripcion t-out="line.name[:300].replace('\n', ' ')"/>
                            <cantidad t-out="format_float(line.quantity, 6)"/>
                            <precioUnitario t-out="format_float(line.price_unit, 6)"/>
                            <descuento t-out="format_monetary(line.price_unit * line.quantity * (line.discount / 100.0))"/>
                            <precioTotalSinImpuesto t-out="format_monetary(line.price_subtotal)"/>
                            <impuestos>
                                <t t-foreach="line_taxes.get(line.id, [])" t-as="imp">
                                    <impuesto>
                                        <codigo t-out="imp['codigo']"/>
                                        <codigoPorcentaje t-out="imp['codigo_porcentaje']"/>
                                        <tarifa t-out="format_float(imp['tarifa'], 2)"/>
                                        <baseImponible t-out="format_monetary(imp['base'])"/>
                                        <valor t-out="format_monetary(imp['valor'])"/>
                                    </impuesto>
                                </t>
                            </impuestos>
                        </detalle>
                    </t>
                </detalles>
                <infoAdicional t-if="move.narration or partner.email">
                    <campoAdicional nombre="Email" t-if="partner.email" t-out="partner.email"/>
                    <campoAdicional nombre="Notas" t-if="move.narration" t-out="move.narration[:300]"/>
                </infoAdicional>
            </liquidacionCompra>
        </template>

        <!-- ============================================================
             codDoc 04 - Nota de Crédito (SRI schema NotaCredito V1.1.0)

             codDocModificado / numDocModificado / fechaEmisionDocSustento
             come from the reversed invoice (vals['modificado']).
        ============================================================ -->
        <template id="l10n_ec_edi_nota_credito">
            <notaCredito id="comprobante" version="1.1.0">
                <infoTributaria>
                    <ambiente t-out="environment"/>
                    <tipoEmision>1</tipoEmision>
                    <razonSocial t-out="company.name[:300]"/>
                    <nombreComercial t-if="company.l10n_ec_commercial_name" t-out="company.l10n_ec_commercial_name[:300]"/>
                    <ruc t-out="company.vat"/>
                    <claveAcceso t-out="access_key"/>
                    <codDoc>04</codDoc>
                    <estab t-out="access_key[24:27]"/>
                    <ptoEmi t-out="access_key[27:30]"/>
                    <secuencial t-out="access_key[30:39]"/>
                    <dirMatriz t-out="company.street[:300]"/>
                    <agenteRetencion t-if="company.l10n_ec_withhold_agent" t-out="company.l10n_ec_withhold_resolution[:8]"/>
                </infoTributaria>
                <infoNotaCredito>
                    <fechaEmision t-out="move.invoice_date.strftime('%d/%m/%Y')"/>
                    <dirEstablecimiento t-if="company.street" t-out="company.street[:300]"/>
                    <tipoIdentificacionComprador t-out="l10n_ec_identifier_code"/>
                    <razonSocialComprador t-out="partner.name[:300]"/>
                    <identificacionComprador t-out="partner.vat"/>
                    <contribuyenteEspecial t-if="company.l10n_ec_taxpayer_type == 'special'" t-out="company.l10n_ec_special_resolution"/>
                    <obligadoContabilidad t-out="'SI' if company.l10n_ec_forced_accounting else 'NO'"/>
                    <codDocModificado t-out="vals['modificado']['cod_doc_modificado']"/>
                    <numDocModificado t-out="vals['modificado']['num_doc_modificado']"/>
                    <fechaEmisionDocSustento t-out="vals['modificado']['fecha_emision_doc_sustento']"/>
                    <totalSinImpuestos t-out="format_monetary(vals['total_sin_impuestos'])"/>
                    <valorModificacion t-out="format_monetary(move.amount_total)"/>
                    <moneda>DOLAR</moneda>
                    <totalConImpuestos>
                        <t t-foreach="vals['taxes']" t-as="tax">
                            <totalImpuesto>
                                <codigo t-out="tax['codigo']"/>
                                <codigoPorcentaje t-out="tax['codigo_porcentaje']"/>
                                <baseImponible t-out="format_monetary(tax['base'])"/>
                                <valor t-out="format_monetary(tax['amount'])"/>
                            </totalImpuesto>
                        </t>
                    </totalConImpuestos>
                    <motivo t-out="vals['modificado']['motivo']"/>
                </infoNotaCredito>
                <detalles>
                    <t t-foreach="move.invoice_line_ids.filtered(lambda l: not l.display_type)" t-as="line">
                        <detalle>
                            <codigoInterno t-out="line.product_id.default_code[:25] if line.product_id.default_code else 'GEN'"/>
                            <descripcion t-out="line.name[:300].replace('\n', ' ')"/>
                            <cantidad t-out="format_float(line.quantity, 6)"/>
                            <precioUnitario t-out="format_float(line.price_unit, 6)"/>
                            <descuento t-out="format_monetary(line.price_unit * line.quantity * (line.discount / 100.0))"/>
                            <precioTotalSinImpuesto t-out="format_monetary(line.price_subtotal)"/>
                            <impuestos>
                                <t t-foreach="line_taxes.get(line.id, [])" t-as="imp">
                                    <impuesto>
                                        <codigo t-out="imp['codigo']"/>
                                        <codigoPorcentaje t-out="imp['codigo_porcentaje']"/>
                                        <tarifa t-out="format_float(imp['tarifa'], 2)"/>
                                        <baseImponible t-out="format_monetary(imp['base'])"/>
                                        <valor t-out="format_monetary(imp['valor'])"/>
                                    </impuesto>
                                </t>
                            </impuestos>
                        </detalle>
                    </t>
                </detalles>
                <infoAdicional t-if="move.narration or partner.email">
                    <campoAdicional nombre="Email" t-if="partner.email" t-out="partner.email"/>
                    <campoAdicional nombre="Notas" t-if="move.narration" t-out="move.narration[:300]"/>
                </infoAdicional>
            </notaCredito>
        </template>

        <!-- ============================================================
             codDoc 05 - Nota de Débito (SRI schema NotaDebito V1.0.0 -
             the only ND schema published by the SRI; NOT 1.1.0)

             No <detalles>: the ND declares <impuestos> inside
             <infoNotaDebito> plus the required <motivos> block.
        ============================================================ -->
        <template id="l10n_ec_edi_nota_debito">
            <notaDebito id="comprobante" version="1.0.0">
                <infoTributaria>
                    <ambiente t-out="environment"/>
                    <tipoEmision>1</tipoEmision>
                    <razonSocial t-out="company.name[:300]"/>
                    <nombreComercial t-if="company.l10n_ec_commercial_name" t-out="company.l10n_ec_commercial_name[:300]"/>
                    <ruc t-out="company.vat"/>
                    <claveAcceso t-out="access_key"/>
                    <codDoc>05</codDoc>
                    <estab t-out="access_key[24:27]"/>
                    <ptoEmi t-out="access_key[27:30]"/>
                    <secuencial t-out="access_key[30:39]"/>
                    <dirMatriz t-out="company.street[:300]"/>
                    <agenteRetencion t-if="company.l10n_ec_withhold_agent" t-out="company.l10n_ec_withhold_resolution[:8]"/>
                </infoTributaria>
                <infoNotaDebito>
                    <fechaEmision t-out="move.invoice_date.strftime('%d/%m/%Y')"/>
                    <dirEstablecimiento t-if="company.street" t-out="company.street[:300]"/>
                    <tipoIdentificacionComprador t-out="l10n_ec_identifier_code"/>
                    <razonSocialComprador t-out="partner.name[:300]"/>
                    <identificacionComprador t-out="partner.vat"/>
                    <contribuyenteEspecial t-if="company.l10n_ec_taxpayer_type == 'special'" t-out="company.l10n_ec_special_resolution"/>
                    <obligadoContabilidad t-out="'SI' if company.l10n_ec_forced_accounting else 'NO'"/>
                    <codDocModificado t-out="vals['modificado']['cod_doc_modificado']"/>
                    <numDocModificado t-out="vals['modificado']['num_doc_modificado']"/>
                    <fechaEmisionDocSustento t-out="vals['modificado']['fecha_emision_doc_sustento']"/>
                    <totalSinImpuestos t-out="format_monetary(vals['total_sin_impuestos'])"/>
                    <impuestos>
                        <t t-foreach="vals['taxes']" t-as="tax">
                            <impuesto>
                                <codigo t-out="tax['codigo']"/>
                                <codigoPorcentaje t-out="tax['codigo_porcentaje']"/>
                                <tarifa t-out="format_float(tax['tarifa'], 2)"/>
                                <baseImponible t-out="format_monetary(tax['base'])"/>
                                <valor t-out="format_monetary(tax['amount'])"/>
                            </impuesto>
                        </t>
                    </impuestos>
                    <valorTotal t-out="format_monetary(move.amount_total)"/>
                    <pagos>
                         <t t-foreach="vals['pagos']" t-as="pago">
                            <pago>
                                <formaPago t-out="pago['code']"/>
                                <total t-out="format_monetary(pago['amount'])"/>
                            </pago>
                        </t>
                    </pagos>
                </infoNotaDebito>
                <motivos>
                    <motivo>
                        <razon t-out="vals['modificado']['motivo']"/>
                        <valor t-out="format_monetary(move.amount_total)"/>
                    </motivo>
                </motivos>
                <infoAdicional t-if="move.narration or partner.email">
                    <campoAdicional nombre="Email" t-if="partner.email" t-out="partner.email"/>
                    <campoAdicional nombre="Notas" t-if="move.narration" t-out="move.narration[:300]"/>
                </infoAdicional>
            </notaDebito>
        </template>

    </data>
</odoo>
