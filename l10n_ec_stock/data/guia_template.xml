<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
          Guía de Remisión electrónica (SRI codDoc 06, v1.1.0).
          Consumes the precomputed helpers on stock.picking
          (l10n_ec_guia_* — see models/stock_picking.py) so the template
          contains no field-name logic:
            * transportista = carrier company (razón social + RUC) when
              set, else individual driver (cédula)
            * placa from l10n_ec_vehicle
            * motivoTraslado as SRI free-text (VENTA, TRASLADO INTERNO...)
            * destinatario identification type via SRI Table 07 codes
          TODO: validate final XML against the SRI "Guía de Remisión"
          schema (v1.1.0) with a live celcer submission.
        -->
        <template id="l10n_ec_guia_xml">
            <guiaRemision id="comprobante" version="1.1.0">
                <infoTributaria>
                    <ambiente t-out="environment"/>
                    <tipoEmision>1</tipoEmision>
                    <razonSocial t-out="company.name[:300]"/>
                    <nombreComercial t-if="company.l10n_ec_commercial_name" t-out="company.l10n_ec_commercial_name[:300]"/>
                    <ruc t-out="company.vat"/>
                    <claveAcceso t-out="access_key"/>
                    <codDoc>06</codDoc>
                    <estab t-out="access_key[24:27]"/>
                    <ptoEmi t-out="access_key[27:30]"/>
                    <secuencial t-out="access_key[30:39]"/>
                    <dirMatriz t-out="company.street[:300]"/>
                </infoTributaria>
                <infoGuiaRemision>
                    <dirEstablecimiento t-out="(picking.picking_type_id.warehouse_id.partner_id.street or company.street or '')[:300]"/>
                    <dirPartida t-out="(picking.picking_type_id.warehouse_id.partner_id.street or company.street or '')[:300]"/>
                    <razonSocialTransportista t-out="picking.l10n_ec_guia_transport_name[:300]"/>
                    <tipoIdentificacionTransportista t-out="picking.l10n_ec_guia_transport_ident_code"/>
                    <rucTransportista t-out="picking.l10n_ec_guia_transport_ident"/>
                    <placa t-out="picking.l10n_ec_guia_placa"/>
                    <fechaIniTransporte t-out="picking.l10n_ec_guia_fecha_ini"/>
                    <fechaFinTransporte t-out="picking.l10n_ec_guia_fecha_fin"/>
                </infoGuiaRemision>
                <destinatarios>
                    <destinatario>
                        <identificacionDestinatario t-out="picking.partner_id.vat or '9999999999999'"/>
                        <tipoIdentificacionDestinatario t-out="picking.l10n_ec_destinatario_ident_code"/>
                        <razonSocialDestinatario t-out="picking.partner_id.name[:300]"/>
                        <dirDestinatario t-out="(picking.partner_id.street or company.street or '')[:300]"/>
                        <motivoTraslado t-out="picking.l10n_ec_guia_motivo"/>
                        <detalles>
                            <t t-foreach="picking.move_ids" t-as="move">
                                <detalle t-if="move.quantity > 0">
                                    <codigoInterno t-out="move.product_id.default_code or str(move.product_id.id)"/>
                                    <descripcion t-out="move.product_id.name[:300]"/>
                                    <cantidad t-out="format_float(move.quantity, 2)"/>
                                </detalle>
                            </t>
                        </detalles>
                    </destinatario>
                </destinatarios>
            </guiaRemision>
        </template>
    </data>
</odoo>
