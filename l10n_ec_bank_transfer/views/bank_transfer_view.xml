<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ec_bank_transfer_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ec.bank.transfer.wizard.form</field>
        <field name="model">l10n_ec.bank.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Bank File">
                <group>
                    <field name="payment_mode"/>
                    <field name="layout_id"/>
                    <field name="payment_date"/>
                    <field name="description"/>
                </group>
                <group string="Payslips to Pay" invisible="payment_mode == 'supplier'">
                    <field name="payslip_ids" widget="many2many_tags"/>
                </group>
                <group string="Vendor Bills to Pay" invisible="payment_mode != 'supplier'">
                    <field name="invoice_ids" widget="many2many_tags"/>
                </group>
                <group invisible="not file_data">
                    <field name="filename" invisible="1"/>
                    <field name="file_data" filename="filename" readonly="1"/>
                </group>
                <footer>
                    <button string="Generate .TXT" name="action_generate" type="object" class="btn-primary" invisible="file_data"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_ec_bank_transfer" model="ir.actions.act_window">
        <field name="name">Generar Archivo de Banco (Nómina/Adelantos)</field>
        <field name="res_model">l10n_ec.bank.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="l10n_ec_hr_payroll.model_l10n_ec_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="context">{'default_payment_mode': 'payroll'}</field>
    </record>

    <record id="action_l10n_ec_bank_transfer_suppliers" model="ir.actions.act_window">
        <field name="name">Pago a Proveedores (Archivo de Banco)</field>
        <field name="res_model">l10n_ec.bank.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="context">{'default_payment_mode': 'supplier'}</field>
    </record>

    <!-- Bank layout config -->
    <record id="view_l10n_ec_bank_layout_list" model="ir.ui.view">
        <field name="name">l10n_ec.bank.layout.list</field>
        <field name="model">l10n_ec.bank.layout</field>
        <field name="arch" type="xml">
            <list string="Bank Layouts">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="bank_code"/>
                <field name="default_concept"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ec_bank_layout_form" model="ir.ui.view">
        <field name="name">l10n_ec.bank.layout.form</field>
        <field name="model">l10n_ec.bank.layout</field>
        <field name="arch" type="xml">
            <form string="Bank Layout">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="bank_code"/>
                        <field name="default_concept"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ec_bank_layout" model="ir.actions.act_window">
        <field name="name">Bank File Layouts</field>
        <field name="res_model">l10n_ec.bank.layout</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_ec_bank_transfer_root"
              name="Bank Files (EC)"
              parent="l10n_ec_hr_payroll.menu_l10n_ec_payroll_root"
              sequence="90"
              groups="hr.group_hr_user"/>

    <menuitem id="menu_l10n_ec_bank_layout"
              name="Bank Layouts"
              parent="menu_l10n_ec_bank_transfer_root"
              action="action_l10n_ec_bank_layout"
              groups="base.group_system"/>
</odoo>
