<?xml version="1.0" encoding="utf-8"?>
<!--
  Report actions for the Ecuadorian statutory books, SRI forms and the
  SUPERCIAS financial statements.

  NOTE: action_report_form_103 / action_report_form_104 keep their historical
  xml ids (referenced by the ATS wizard shortcuts); their model is now
  l10n_ec.form.wizard, which owns the real Form 103/104 calculations.
-->
