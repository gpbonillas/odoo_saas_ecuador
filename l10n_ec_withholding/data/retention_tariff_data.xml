            <field name="withholding_tax_id" ref="tax_ret_ir_307"/>
        </record>
        <record id="tariff_renta_professional_any" model="l10n_ec.retention.tariff">
            <field name="tax_type">renta</field>
            <field name="ruc_digit">any</field>
            <field name="activity">professional</field>
            <field name="sequence">10</field>
            <field name="withholding_tax_id" ref="tax_ret_ir_303"/>
        </record>
        <record id="tariff_renta_transport_any" model="l10n_ec.retention.tariff">
            <field name="tax_type">renta</field>
            <field name="ruc_digit">any</field>
            <field name="activity">transport</field>
            <field name="sequence">10</field>
            <field name="withholding_tax_id" ref="tax_ret_ir_310"/>
