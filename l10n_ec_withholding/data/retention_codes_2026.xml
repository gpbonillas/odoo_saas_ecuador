        <!-- ========================================================= -->
        <!-- =========================================================
             TABLA 21: RETENCIONES IVA — CASILLEROS FORMULARIO 104
             =========================================================
             Base: Resolución NAC-DGERCGC20-00000061 (RO 473,
             29-sep-2020) y SUS REFORMAS (NAC-DGERCGC21-00000037,
             NAC-DGERCGC23-00000026). VIGENTE en 2026: los porcentajes
             de IVA NO cambiaron en la reforma de marzo-2026 (solo
             cambió Impuesto a la Renta vía NAC-DGERCGC26-00000009).

             Los casilleros del 104 son BÚSQUEDAS DE PORCENTAJE, no de
             materia. Cada casillero fija un % del IVA causado retenido:
                 721 = 10%   723 = 20%   725 = 30%
                 727 = 50%   729 = 70%   731 = 100%
             (Fuente: Guía SRI del Formulario 104 — "721, 723: retención
             10% y 20%; 725, 727, 729 y 731: 30%, 50%, 70% y 100%").

             ESCALA DOBLE: el % depende de la relación entre el AGENTE
             de retención y el retenido (Res. 61 Arts. 3-5):
               • CONTRIBUTUYENTE ESPECIAL → otro contribuyente especial:
                   10% bienes (721), 20% servicios/consultoría (723),
                   30% construcción (725).
               • ESCALA GENERAL (demás casos):
                   30% bienes y construcción (725),
                   70% servicios/consultoría y arrendamiento a obligados
                     a llevar contabilidad (729),
                   100% servicios profesionales de personas naturales
                     (excepto consultoría), arrendamiento a personas
                     naturales NO obligadas, liquidación de compra,
                     importación de servicios, combustibles (731).
             • EXPORTADORES HABITUALES (agentes/especiales): retienen
               100% en TODAS las adquisiciones (Art. 11) → siempre 731.
             El motor (l10n_ec_withholding / mcp_server/rules.py
             iva_retention_bucket) selecciona el casillero según estos
             criterios; estas filas solo fijan % por casillero.
        ========================================================== -->
        <!-- 10% — bienes a contribuyentes especiales (Art. 5.a) -->
        <record id="tax_ret_iva_721" model="l10n_ec.withholding.tax">
            <field name="code">721</field>
            <field name="name">Retención IVA 10% — bienes (contribuyente especial a contribuyente especial)</field>
            <field name="type">iva</field>
            <field name="percentage">10.0</field>
        </record>
        <!-- 20% — servicios a contribuyentes especiales (Art. 5.b) -->
        <record id="tax_ret_iva_723" model="l10n_ec.withholding.tax">
            <field name="code">723</field>
            <field name="name">Retención IVA 20% — servicios y consultoría (a contribuyente especial)</field>
            <field name="type">iva</field>
            <field name="percentage">20.0</field>
        </record>
        <!-- 30% — bienes (general) y TODA construcción (Arts. 3.a y 5.c) -->
        <record id="tax_ret_iva_725" model="l10n_ec.withholding.tax">
            <field name="code">725</field>
            <field name="name">Retención IVA 30% — bienes (escala general) y contratos de construcción</field>
            <field name="type">iva</field>
            <field name="percentage">30.0</field>
        </record>
        <!-- 50% — casillero previsto por la Res. 61 (casos específicos) -->
        <record id="tax_ret_iva_727" model="l10n_ec.withholding.tax">
            <field name="code">727</field>
            <field name="name">Retención IVA 50% (casillero Res. 61)</field>
            <field name="type">iva</field>
            <field name="percentage">50.0</field>
        </record>
        <!-- 70% — servicios (general) y arrendamiento a obligados (Art. 3.b) -->
        <record id="tax_ret_iva_729" model="l10n_ec.withholding.tax">
            <field name="code">729</field>
            <field name="name">Retención IVA 70% — servicios, consultoría y arrendamiento (escala general)</field>
            <field name="type">iva</field>
            <field name="percentage">70.0</field>
        </record>
        <!-- 100% — honorarios, arrendamiento a no obligados, liquidación
             de compra, importación de servicios, combustibles, y TODAS
             las adquisiciones de exportadores habituales (Art. 11) -->
        <record id="tax_ret_iva_731" model="l10n_ec.withholding.tax">
            <field name="code">731</field>
            <field name="name">Retención IVA 100% — servicios profesionales personas naturales, arrendamiento a no obligados, liquidación de compra, importación de servicios y exportadores</field>
            <field name="type">iva</field>
            <field name="percentage">100.0</field>
        </record>

